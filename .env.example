# Drop Me A Question -- environment variables
#
# Copy this file to .env.local for local development and fill in real values.
# NEVER commit real values: .env.local (and every other .env* file) is
# gitignored; only this template is tracked.
#
# For Vercel, set each variable under Project Settings -> Environment
# Variables and choose its scope deliberately: Production, Preview and
# Development are separate. Most past go-live bugs here were a value set in
# the wrong scope. "Prod scope" notes below say what Production must hold.
#
# Rule of thumb: local and Preview use the DEV Supabase project and Stripe
# TEST keys; Production uses the PROD Supabase project and Stripe LIVE keys.
# Never mix values from two environments inside one scope.

# ---------------------------------------------------------------------------
# Supabase -- all three must come from the SAME project (Project Settings ->
# API). A mismatched anon key gives "Invalid API key"; a mismatched service
# role key breaks every server route.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses Row Level Security -- never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Stripe -- test keys (sk_test_...) everywhere except Production, which must
# use live keys (sk_live_...). The webhook secret belongs to one specific
# webhook endpoint in one mode; test and live secrets are different.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
# Endpoint: <site>/api/stripe/webhook. Events: checkout.session.completed,
# account.updated.
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Site URLs
# ---------------------------------------------------------------------------
# Where Stripe redirects people after checkout / onboarding. Per environment:
# http://localhost:3000 locally, https://www.dropmeaquestion.com in Prod scope.
# If unset the app falls back to the real domain (see lib/site.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Used in emails, sitemap and social-share links. These must resolve outside
# your machine, so keep it as the real domain in EVERY environment, including
# local. Optional: defaults to https://www.dropmeaquestion.com.
EMAIL_BASE_URL=https://www.dropmeaquestion.com

# ---------------------------------------------------------------------------
# Email + AI
# ---------------------------------------------------------------------------
# Resend: sends answer notifications, password resets and admin mail.
RESEND_API_KEY=
# Anthropic: powers the "improve my bio" helper.
ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Admin
# ---------------------------------------------------------------------------
# Comma-separated emails allowed into /admin and "Login as". Case-insensitive.
# Empty means no admins (fails closed).
ADMIN_EMAILS=you@example.com

# ---------------------------------------------------------------------------
# Cron
# ---------------------------------------------------------------------------
# Protects /api/cron/* (question expiry, payment reconciliation). Vercel sends
# it automatically as "Authorization: Bearer <value>" once it is set, so set
# it in Production scope. Use a long random string (e.g. `openssl rand -hex 32`).
CRON_SECRET=

# ---------------------------------------------------------------------------
# Video proof of concept (admin only; see docs/video-provider-comparison.md)
# ---------------------------------------------------------------------------
# Daily API key (dashboard > Developers) and a base64 secret that signs their
# webhooks to us: `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`
DAILY_API_KEY=
DAILY_WEBHOOK_HMAC=
# "dmq" turns on DMQ-hosted audio rooms for follow-up conversations; anything
# else (or empty) keeps the expert pasting their own meeting link.
FOLLOW_UP_VIDEO=
# Spending guard on rooms. Defaults: 100 rooms per day, 10 calls at once.
VIDEO_MAX_ROOMS_PER_DAY=
VIDEO_MAX_CONCURRENT=

# ---------------------------------------------------------------------------
# Pre-launch maintenance gate (middleware.ts)
# ---------------------------------------------------------------------------
# "true" shows the /coming-soon page to everyone who lacks the bypass cookie.
# For launch: set to "false" in Prod scope and redeploy.
MAINTENANCE_MODE=true
# Visit /?dmq_preview=<this value> once to set a 90-day bypass cookie. Rotate it
# before launch if it was ever shared.
MAINTENANCE_BYPASS_TOKEN=
